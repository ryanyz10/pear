#!/usr/bin/env bash
# Shim: run TypeScript directly. Node >=24 needs no flags; 22.19–23 need
# --experimental-strip-types. Below 22.19 is unsupported (pi-agent-core floor).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

NODE_BIN="${NODE_BIN:-node}"
if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  echo "pear: node not found" >&2
  exit 1
fi

VER="$("$NODE_BIN" -p "process.versions.node")"
MAJOR="${VER%%.*}"
REST="${VER#*.}"
MINOR="${REST%%.*}"

ok=0
if (( MAJOR > 22 )); then ok=1
elif (( MAJOR == 22 && MINOR >= 19 )); then ok=1
fi
if (( !ok )); then
  echo "pear: needs Node >=22.19 (you have v${VER})" >&2
  echo "  tip (asdf 0.16+): asdf set nodejs 22.22.3   # then: node -v" >&2
  echo "  or: PATH=\"\$HOME/.asdf/installs/nodejs/22.22.3/bin:\$PATH\" ./bin/pear" >&2
  exit 1
fi

ARGS=()
if (( MAJOR < 24 )); then
  ARGS+=(--experimental-strip-types --no-warnings=ExperimentalWarning)
fi
exec "$NODE_BIN" "${ARGS[@]}" "$ROOT/src/cli.ts" "$@"
