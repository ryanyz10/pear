{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--experimental-strip-types", "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.ts"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--experimental-strip-types", "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.ts"]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--experimental-strip-types", "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.ts"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--experimental-strip-types", "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.ts"]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--experimental-strip-types", "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ts"]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--experimental-strip-types", "${CLAUDE_PLUGIN_ROOT}/hooks/session-end.ts"]
          }
        ]
      }
    ]
  }
}
