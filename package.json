{
  "name": "pi-pear",
  "version": "0.1.2",
  "description": "Pair-programming checkpoint loop for pi: the agent pauses after each logical change and asks the human to continue, steer, or stop",
  "type": "module",
  "license": "MIT",
  "author": "ryanyz10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanyz10/pear.git"
  },
  "bugs": {
    "url": "https://github.com/ryanyz10/pear/issues"
  },
  "homepage": "https://github.com/ryanyz10/pear#readme",
  "keywords": [
    "pi-package",
    "pair-programming",
    "checkpoint"
  ],
  "files": [
    "adapters",
    "core",
    "skills"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke:pi": "bash scripts/smoke-pi.sh",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./adapters/pi/extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "shell-quote": "1.10.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "22.20.1",
    "@types/shell-quote": "1.7.5",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
